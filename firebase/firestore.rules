rules_version = '2';

// This app never talks to Firestore from the browser — all reads and
// writes (reviews, columns, inquiries) go through the Firebase Admin SDK
// on the server, which bypasses these rules entirely. So the only thing
// these rules need to do is deny every direct client request.
//
// Deploy this in the Firebase Console: Firestore Database > Rules tab,
// paste this file's contents, and click "Publish".
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
