# Supabase project settings (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (https://resend.com) for operator email notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# Password for the minimal /admin dashboard gate
ADMIN_PASSWORD=

# Firebase Admin SDK (Project Settings > Service accounts > Generate new
# private key). Used server-side only, for reviews/columns/inquiries.
# Paste FIREBASE_PRIVATE_KEY with literal \n sequences, in quotes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
