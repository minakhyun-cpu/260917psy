# Supabase project settings (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (https://resend.com) for operator email notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# Password for the minimal /admin dashboard gate
ADMIN_PASSWORD=

# Firebase Admin SDK (Project Settings > Service accounts > Generate new
# private key). Server-only — used for columns (read+write) and admin-only
# moderation of reviews/inquiries. Paste FIREBASE_PRIVATE_KEY with literal
# \n sequences, in quotes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase client SDK config (Project Settings > General > Your apps > SDK
# setup and configuration). These are not secret — they're meant to be
# public — and are used by the browser for the reviews/contact forms.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
